# 代理配置 - 如果您希望通过代理发送请求
PROXY=http://127.0.0.1:7890

# 标准环境变量（许多应用程序会自动识别这些变量）
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
http_proxy=http://127.0.0.1:7890
https_proxy=http://127.0.0.1:7890

# MIN_SLEEP_MS: 每条请求之间的最小等待（毫秒）
MIN_SLEEP_MS=800
# MAX_SLEEP_MS: 每条请求之间的最大等待（毫秒）
MAX_SLEEP_MS=2200

# Twitter username to scrape
TARGET_USER=CGTNOfficial

# Cookies file for Playwright authenticated scraping
COOKIES_FILE=twitter_cookies.json
